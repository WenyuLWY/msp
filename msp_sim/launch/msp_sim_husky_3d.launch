<!-- -->
<launch>
    <param name="use_sim_time" value="true" />
    <!-- <arg name="world_name"              default="$(find msp_sim)/world/room_with_corner.world" /> -->
    <!-- <arg name="world_name"              default="$(find msp_sim)/world/1f_room1/1f_room1.world" /> -->
    <arg name="world_name"              default="$(find msp_sim)/world/SLABIM/floor1/floor1.world" />


    <arg name="x_pos"               default="80.85"/>
    <arg name="y_pos"               default="-7.35"/>
    <arg name="z_pos"               default="0"/>



      <!--  $(find vehicle_simulator)/world/indoor.world
        $(find msp_sim)/world/room_with_corner.world -->
    <arg name="robotName"               default="husky"/>
    <arg name="laserCloudTopic"         default="/velodyne_points"/>
    <arg name="base_frame_id"           default="base_link"/>
    <arg name="lidar_frame_id"          default="velodyne"/>
    <arg name="pubOdometryTopic"        default="/odom/ground_truth"/>



    <!-- 2d -->
    <!-- publish /odom topic  -->
    <include file="$(find msp)/launch/msp.launch">
        <arg name="lod_density"             value="0.152" />
        <arg name="loa_accuracy"            value="0.013" /> 
        <arg name="odom_frame_id"           value="odom"/>
        <arg name="lidar_frame_id"          value="$(arg lidar_frame_id)" />
        <!-- frame_id of robot top urdf link -->
        <arg name="robot_base_frame_id"     value="$(arg base_frame_id)" /> 
        <arg name="raw_cloud_topic"         value="$(arg laserCloudTopic)" />
        <arg name="odometry_topic"          value="$(arg pubOdometryTopic)" /> 
        <arg name="mode"                    value="3d" />
        <!-- frame_id of odometry topic -->
        <arg name="source_frame_id"         value="$(arg base_frame_id)"/> 
        <arg name="publish_odom_tf"         value="true"/>
    </include>
    

    <include file="$(find msp_sim)/launch/sim_gazebo_world.launch">
        <arg name="gazebo_gui"              value="true" />
        <arg name="world_name"              value="$(arg world_name)" />
    </include>

    <include file="$(find msp_sim)/launch/sim_husky.launch">
        <arg name="x_pos"                   value="$(arg x_pos)"/>
        <arg name="y_pos"                   value="$(arg y_pos)"/>
        <arg name="z_pos"                   value="$(arg z_pos)"/>
        <arg name="laser_3d_enabled"        value="1"/>
        <arg name="laser_3d_frequency"      value="10"/>
    </include>

    <include file="$(find msp_sim)/launch/sim_slam.launch">
        <arg name="laserCloudTopic"         value="$(arg laserCloudTopic)"/>
        <arg name="base_frame_id"           value="$(arg base_frame_id)"/>
    </include>


    <!-- <include file="$(find explore_lite)/launch/explore_costmap.launch">
    </include> -->

    <!-- <include file="$(find explore_lite)/launch/explore.launch">
    </include> -->

    <node pkg="hector_trajectory_server" type="hector_trajectory_server" name="hector_trajectory_server" output="screen">
        <param name="target_frame_name" type="string" value="map" />
        <param name="source_frame_name" type="string" value="base_link" />
        <param name="trajectory_update_rate" type="double" value="10.0" />
        <param name="trajectory_publish_rate" type="double" value="10.0" />
    </node>

    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz_run" args="-d $(find msp)/rviz/rviz_sim_3d.rviz" respawn="false" /> 

</launch>