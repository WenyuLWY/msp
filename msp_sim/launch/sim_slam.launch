    <!-- <include file="$(find msp)/launch/localization/rtabmap_slam.launch">
        <arg name="use_sim_time"               default="true"/>
        <arg name="odometry_topic"             default="/odom"/>
        <arg name="publish_odom_tf"            default="false"/>
        <arg name="rtabmap_viz"                default="false"/>
    </include> -->

    <include file="$(find msp)/launch/localization/dlo.launch">
        <arg name="pointcloud_topic"      value="$(arg laserCloudTopic)"/>
        <!-- <arg name="imu_topic"             value="/imu/data"/> -->
        <arg name="pub_odometry_topic"    value="$(arg pubOdometryTopic)"/>
        <arg name="robot_namespace"        value="robot"/> 
  </include>
    <node pkg="tf2_ros" type="static_transform_publisher" name="map2odom"  args="0 0 0 0 0 0 map odom"/>

</launch>