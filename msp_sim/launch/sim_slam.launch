<!-- -->
<launch>

    <arg name="robotName"                   default="husky"/>
    <!-- <arg name="robotName"                   default="turtlebot3_burger"/> -->

    <arg name="laserCloudTopic"             default="/velodyne_points"/>
    <arg name="base_frame_id"               default="base_footprint"/>
    <arg name="pubOdometryTopic"            default="/odom"/>

    <node pkg="tf2_ros" type="static_transform_publisher" name="world2map" args="80.85 -7.35 0 0 0 0 world map" />

    <!-- localization and octomapping -->
