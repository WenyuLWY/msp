<?xml version="1.0" encoding="utf-8"?>
<robot name="ranger_mini_v3"  xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro" />

  <link name="dummy_base_link"/>  
  <joint name="dummy_joint" type="fixed">  
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="dummy_base_link"/>  
      <child link="base_link"/>  
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.0242698272228022 -0.0030308024613212 0.0544267444673498" rpy="0 0 0" />
      <mass value="10" />
      <inertia ixx="0.1354" ixy="0.0" ixz="0.0" iyy="0.2417" iyz="0.0" izz="0.3085"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/ranger_base.dae" scale="1000 1000 1000" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <geometry>
        <box size="0.5 0.35 0.2"/>
      </geometry>
    </collision>
  </link>

  <link name="top_plate_link">
    <visual>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.50"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.50"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
              iyy="0.01" iyz="0"
              izz="0.001"/>
    </inertial>
  </link>

  <joint name="base_to_plate" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <xacro:VLP-16 parent="top_plate_link" topic="velodyne_points" name="velodyne" hz="10" gpu="1">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:VLP-16>

  <link name="fr_steering_wheel_link">
    <inertial>
      <origin xyz="1.8493E-05 1.2713E-06 0.043679" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.0063625" ixy="-1.0581E-07" ixz="-4.0831E-07" iyy="0.006363" iyz="-3.4944E-08" izz="0.010465" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/steering_wheel.dae" scale="10 10 10"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- <mesh
          filename="package://ranger_mini_v3/meshes/ranger_mini_v3_wheel_right.dae" /> -->
        <cylinder radius="0.001" length="0.001"/>
      </geometry>
    </collision>
  </link>




  <link name="fr_wheel_link">
    <inertial>
      <mass value="8" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>            
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.14 0 0" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/wheel_v3.dae" scale="10 10 10"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.005" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.08" radius="0.09" />
      </geometry>
      <contact>
        <ode>
          <min_depth>0.001</min_depth>
        </ode>
      </contact>
    </collision>
  </link>




  <link name="fl_steering_wheel_link">
    <inertial>
      <origin xyz="-0.0017956 -9.6304E-08 0.043642" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.0063695" ixy="-2.1067E-08" ixz="-0.00016867" iyy="0.006363" iyz="-1.0301E-08" izz="0.010458" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/steering_wheel.dae" scale="10 10 10"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- <mesh
          filename="package://ranger_mini_v3/meshes/ranger_mini_v3_wheel.dae" /> -->
        <cylinder radius="0.001" length="0.001"/>
      </geometry>
    </collision>
  </link>



  <link name="fl_wheel_link">
    <inertial>
      <mass value="8" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>            
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/wheel_v3.dae" scale="10 10 10"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.005" rpy="1.57 0 0" />
        <geometry>
          <cylinder length="0.08" radius="0.09" />
        </geometry>
        <contact>
          <ode>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
    </collision>
  </link>



  <link name="rl_steering_wheel_link">
    <inertial>
      <origin xyz="-0.00017093 6.1255E-08 0.043678" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.0063627" ixy="-2.1069E-08" ixz="-1.587E-05" iyy="0.006363" iyz="9.3201E-09" izz="0.010465" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/steering_wheel.dae" scale="10 10 10"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <!-- <mesh
            filename="package://ranger_mini_v3/meshes/ranger_mini_v3_wheel_right.dae" /> -->
          <cylinder radius="0.001" length="0.001"/>
        </geometry>
    </collision>
  </link>



  <link name="rl_wheel_link">
    <inertial>
      <mass value="8" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>            
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/wheel_v3.dae" scale="10 10 10"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.00 0.00 -0.005" rpy="1.57 0 0" />
        <geometry>
          <cylinder length="0.08" radius="0.09" />
        </geometry>
        <contact>
          <ode>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
    </collision>
  </link>


  <link name="rr_steering_wheel_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0"/>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin  xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/steering_wheel.dae" scale="10 10 10"/>
      </geometry>
    </visual>
    <collision>
      <origin  xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.001" length="0.001"/>
      </geometry>
    </collision>
  </link>



  <link name="rr_wheel_link">
    <inertial>
      <mass value="8" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.02047" ixy="0.0" ixz="0.0" iyy="0.02047" iyz="0.0" izz="0.0324"/>            
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="3.14 0 0" />
      <geometry>
        <mesh filename="package://ranger_mini_v3/meshes/wheel_v3.dae" scale="10 10 10"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz=" 0 0 -0.005" rpy="1.57 0 0" />
      <geometry>
        <cylinder length="0.08" radius="0.09" />
      </geometry>
      <contact>
        <ode>
          <min_depth>0.001</min_depth>
        </ode>
      </contact>
    </collision>
  </link>

  <joint name="fr_steering_joint" type="revolute">     
    <origin xyz="0.25 -0.19 -0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="fr_steering_wheel_link" />
    <axis xyz="0 0 1" />
    <limit effort="5" velocity="6.28"  lower="-2.1" upper="2.1" />
  </joint>

  <joint name="fr_wheel" type="continuous">
    <origin xyz="0.0 0.0 -0.12" rpy="0 0 0" />
    <parent link="fr_steering_wheel_link"/>
    <child link="fr_wheel_link"/>
    <axis xyz="0 1 0" rpy="0 0 0" />
  </joint>

  <joint name="fl_steering_joint" type="revolute">
    <origin xyz="0.25 0.19 -0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="fl_steering_wheel_link" />
    <axis xyz="0 0 1" />
    <limit effort="5" velocity="6.28"  lower="-2.1" upper="2.1" />
  </joint>

  <joint name="fl_wheel" type="continuous">
    <origin xyz="0.0 0.0 -0.12" rpy="0 0 0" />
    <parent link="fl_steering_wheel_link"/>
    <child link="fl_wheel_link"/>
    <axis xyz="0 1 0" rpy="0 0 0" />
  </joint>

  <joint name="rl_steering_joint" type="revolute">
    <origin xyz="-0.25 0.19 -0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rl_steering_wheel_link" />
    <axis xyz="0 0 1" />
    <limit effort="5" velocity="6.28"  lower="-2.1" upper="2.1" />
  </joint>

  <joint name="rl_wheel" type="continuous">
    <origin xyz="0.0 0.0 -0.12 " rpy="0 0 0" />
    <parent link="rl_steering_wheel_link"/>
    <child link="rl_wheel_link"/>
    <axis xyz="0 1 0" rpy="0 0 0" />
  </joint>

  <joint name="rr_steering_joint" type="revolute">
      <origin xyz="-0.23 -0.206 -0.1" rpy="0 0 0" />
      <parent link="base_link"/>
      <child link="rr_steering_wheel_link"/>
      <axis xyz="0 0 1" rpy="0 0 0" />
      <limit effort="5" velocity="6.28"  lower="-2.1" upper="2.1" />
  </joint>
  
  <joint name="rr_wheel" type="continuous">
    <origin xyz="0.0 0.0 -0.12 " rpy="0 0 0" />
    <parent link="rr_steering_wheel_link"/>
    <child link="rr_wheel_link"/>
    <axis xyz="0 1 0" rpy="0 0 0" />
  </joint>



  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>

