# FROM osrf/ros:noetic-desktop-full
FROM nvidia/opengl:1.0-glvnd-devel-ubuntu20.04

ARG DEBIAN_FRONTEND=noninteractive

#base
# RUN apt update && apt upgrade -y
RUN apt-get update && apt-get install -y lsb-release curl wget ca-certificates git gnupg gdb

#ros-noetic-desktop (no gazebo)
RUN sh -c 'echo "deb http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" > /etc/apt/sources.list.d/ros-latest.list'
RUN curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | apt-key add -
RUN apt-get update && apt-get install -y ros-noetic-desktop ros-noetic-perception
RUN apt-get update && apt-get install -y python3-pip python3-rosdep python3-rosinstall python3-rosinstall-generator python3-wstool build-essential python3-catkin-tools python-is-python3

#gazebo
RUN apt-get update && apt-get install -y libsdformat9-dev \
        libignition-msgs5-dev libignition-transport8-dev libignition-common3-dev libignition-fuel-tools4-dev \
        libfreeimage-dev libtar-dev libqwt-qt5-dev
# #remove gazebo and build from source
# RUN apt-get remove -y '.*gazebo.*' '.*sdformat.*' '.*ignition-math.*' '.*ignition-msgs.*' '.*ignition-transport.*'
RUN sh -c 'echo "deb http://packages.osrfoundation.org/gazebo/ubuntu-stable `lsb_release -cs` main" > /etc/apt/sources.list.d/gazebo-stable.list' && \
    wget https://packages.osrfoundation.org/gazebo.key -O - | apt-key add - && \
    wget https://raw.githubusercontent.com/ignition-tooling/release-tools/master/jenkins-scripts/lib/dependencies_archive.sh -O /tmp/dependencies.sh && \
    GAZEBO_MAJOR_VERSION=11 ROS_DISTRO=noetic . /tmp/dependencies.sh && \
    echo "$BASE_DEPENDENCIES $GAZEBO_BASE_DEPENDENCIES" | tr -d '\\' | xargs apt-get install -y && \
    rm -f /tmp/dependencies.sh

# WORKDIR /home/user


RUN git clone --depth 1 https://github.com/enwaytech/gazebo.git /tmp/gazebo
RUN set -eux; \
    CORES=$(nproc); \
    JOBS=$((CORES>1 ? CORES-1 : 1)); \
    cd /tmp/gazebo && \
    mkdir -p build && \
    cd build && \
    # cmake -DCMAKE_INSTALL_PREFIX=/home/user/local .. && \
    cmake .. && \
    make -j${JOBS} && \
    make install && \
    rm -rf /tmp/gazebo

#add user
RUN groupadd -g 1000 user && \
    useradd -m -u 1000 -g 1000 -s /bin/bash user && \
    echo "user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

#Livox
RUN git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK.git /tmp/Livox-SDK
RUN set -eux; \
    CORES=$(nproc); \
    JOBS=$((CORES>1 ? CORES-1 : 1)); \
    cd /tmp/Livox-SDK && \
    mkdir -p build && \
    cd build && cmake .. && \
    make -j${JOBS} && \
    make install && \
    rm -rf /tmp/Livox-SDK


#add to desktop
RUN apt-get update && apt-get install -y ros-noetic-ros-control ros-noetic-ros-controllers ros-noetic-control-toolbox
# #develop
RUN apt-get update && apt-get install -y ros-noetic-hector-trajectory-server  ros-noetic-tf2-sensor-msgs ros-noetic-geographic-msgs
# #HUSKY
RUN apt-get update && apt-get install -y ros-noetic-flir-camera-description ros-noetic-fath-pivot-mount-description \
    ros-noetic-lms1xx  ros-noetic-interactive-marker-twist-server ros-noetic-twist-mux 

# #autonomous_exploration_development_environment
RUN apt-get update && apt-get install -y libusb-dev
# #DLO
# RUN apt-get update && apt-get install -y libomp-dev libpcl-dev libeigen3-dev 
# #DSV planner
# RUN apt-get update && apt-get install -y ros-noetic-octomap-ros libgoogle-glog-dev libgflags-dev


                                            # ros-noetic-rtabmap-sync ros-noetic-rtabmap-util ros-noetic-rtabmap-legacy \
                                            # ros-noetic-rtabmap-launch
# #RTABMAP
# RUN apt-get update && apt-get install -y ros-noetic-rtabmap-ros ros-noetic-libpointmatcher ros-noetic-libg2o ros-noetic-gtsam
RUN apt-get update && apt-get install -y ros-noetic-rtabmap-odom ros-noetic-rtabmap-slam ros-noetic-rtabmap-launch \
                                            ros-noetic-libpointmatcher ros-noetic-libg2o ros-noetic-gtsam

# #2D nav
RUN apt-get update && apt-get install -y ros-noetic-pointcloud-to-laserscan ros-noetic-point-cloud2-filters ros-noetic-navigation ros-noetic-teb-local-planner ros-noetic-explore-lite

# # # RUN git clone https://github.com/vectr-ucla/direct_lidar_odometry.git --depth 1 /root/dependencies_catkin_ws/src/direct_lidar_odometry
# # # RUN git clone https://github.com/vectr-ucla/direct_lidar_inertial_odometry.git --depth 1 /root/dependencies_catkin_ws/src/direct_lidar_inertial_odometry
# # # RUN git clone https://github.com/hku-mars/FAST_LIO.git --depth 1 /root/dependencies_catkin_ws/src/FAST_LIO && cd /root/dependencies_catkin_ws/src/FAST_LIO && \
# #     # git submodule update --init


USER user
# # ros dependencies workspace
RUN mkdir -p /home/user/catkin_ws/src /home/user/dependencies_catkin_ws/src
RUN git clone https://github.com/ros-simulation/gazebo_ros_pkgs.git --depth 1 -b noetic-devel /home/user/dependencies_catkin_ws/src/gazebo_ros_pkgs
RUN git clone https://github.com/Livox-SDK/livox_ros_driver.git --depth 1 /home/user/dependencies_catkin_ws/src/livox_ros_driver
RUN git clone https://bitbucket.org/DataspeedInc/velodyne_simulator.git --depth 1 -b master /home/user/dependencies_catkin_ws/src/velodyne_simulator
RUN git clone https://github.com/tu-darmstadt-ros-pkg/hector_gazebo.git --depth 1 /home/user/dependencies_catkin_ws/src/hector_gazebo
RUN git clone https://github.com/husky/husky.git --depth 1 /home/user/dependencies_catkin_ws/src/husky  
RUN git clone https://github.com/WenyuLWY/livox_laser_simulation.git --depth 1 /home/user/dependencies_catkin_ws/src/livox_laser_simulation
# RUN git clone https://github.com/enwaytech/livox_laser_simulation.git --depth 1 /home/user/dependencies_catkin_ws/src/livox_laser_simulation
RUN git clone https://github.com/UCR-Robotics/pointcloud2_normal_rviz_plugin.git --depth 1 /home/user/dependencies_catkin_ws/src/pointcloud2_normal_rviz_plugin

# ENV CMAKE_PREFIX_PATH=/usr/local:${CMAKE_PREFIX_PATH}
ENV LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}
ENV PATH=/usr/local/bin:${PATH}
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH}

ENV GAZEBO_RESOURCE_PATH=/usr/local/share/gazebo-11${GAZEBO_RESOURCE_PATH}
ENV GAZEBO_MODEL_PATH=/usr/local/share/gazebo-11/models${GAZEBO_MODEL_PATH}
ENV GAZEBO_PLUGIN_PATH=/usr/local/lib/gazebo-11/plugins:${GAZEBO_PLUGIN_PATH}


RUN cd /home/user/dependencies_catkin_ws && \
    catkin config --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    bash -c "source /opt/ros/noetic/setup.bash && catkin build"

RUN cd /home/user/catkin_ws && \
    catkin config --extend /home/user/dependencies_catkin_ws/devel && \
    catkin config --cmake-args -DCMAKE_BUILD_TYPE=Release
  
RUN bash -c 'printf "%s\n" \
    "export DISABLE_ROS1_EOL_WARNINGS=1" \
    "source /opt/ros/noetic/setup.bash" \
    "source /home/user/dependencies_catkin_ws/devel/setup.bash" \
    "source /home/user/catkin_ws/devel/setup.bash" \
    >> /home/user/.bashrc'

RUN bash -c 'printf "%s\n" \
    "#!/bin/bash" \
    "cd /home/user/catkin_ws" \
    "source /opt/ros/noetic/setup.bash" \
    "source /home/user/dependencies_catkin_ws/devel/setup.bash" \
    "CORES=\$(nproc)" \
    "JOBS=\$((CORES>1 ? CORES-1 : 1))" \
    "catkin build -j\$JOBS" \
    "source /home/user/catkin_ws/devel/setup.bash" \
    "exec \"\$@\"" \
    > /home/user/start.sh \
    && chmod +x /home/user/start.sh'

RUN mkdir -p ~/.gazebo ~/.gazebo/models ~/tmp/runtime-root
# RUN git clone --depth 1 https://github.com/osrf/gazebo_models.git ~/.gazebo/models
# ENV GAZEBO_MODEL_PATH=~/gazebo_models:${GAZEBO_MODEL_PATH}
# ENV GAZEBO_MODEL_PATH=~/.gazebo/models:${GAZEBO_MODEL_PATH}

ENTRYPOINT ["/home/user/start.sh"]

CMD ["/bin/bash"]
